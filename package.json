{
  "name": "nartya",
  "version": "0.1.0",
  "private": true,
  "description": "Anime streaming desktop app",
  "license": "MIT",
  "author": "Nartya Team",
  "type": "module",
  "main": "dist-electron/electron/main.mjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:web && npm run build:electron",
    "build:web": "node scripts/clean.ts dist && vite build",
    "build:electron": "node scripts/clean.ts dist-electron && tsc -p tsconfig.electron.json && node scripts/build-config.ts",
    "electron": "npm run build:electron && electron .",
    "electron:dev": "npm run build:electron && node scripts/electron-dev.ts",
    "lint": "npm run typecheck && eslint . && prettier --check . && node scripts/check-style.ts",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.test.json && tsc -p tsconfig.scripts.json && tsc -p tsconfig.electron.json --noEmit",
    "format": "prettier --write .",
    "metrics": "node scripts/metrics.ts",
    "test": "node --test",
    "prepare": "git config core.hooksPath .githooks",
    "smoke": "electron dist-electron/electron/smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/dns-packet": "^5.6.5",
    "@types/multicast-dns": "^7.2.4",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@webgpu/types": "0.1.74",
    "autoprefixer": "^10.4.22",
    "electron": "^44.4.3",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "postcss": "^8.5.6",
    "prettier": "^3.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "3.4.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.46.2",
    "vite": "^7.3.6",
    "zustand": "^5.0.9"
  },
  "dependencies": {
    "@radix-ui/react-select": "^2.3.7",
    "@supabase/supabase-js": "^2.116.0",
    "anime4k-webgpu": "1.0.0",
    "artplayer": "^5.4.0",
    "castv2-client": "1.2.0",
    "dns-packet": "^5.6.1",
    "embla-carousel-react": "^8.6.0",
    "hls.js": "^1.7.3",
    "lucide-react": "^0.559.0",
    "multicast-dns": "^7.2.5",
    "react-router-dom": "^7.18.2"
  },
  "overrides": {
    "protobufjs": "^7.6.3"
  }
}
