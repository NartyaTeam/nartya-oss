{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "src/vite-env.d.ts",
    "types",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "electron/**/*.test.mts"
  ]
}
