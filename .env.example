# Supabase project used by the app. Both values are public by design.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-public-key>

# Catalog API. Read by the front end, and by the main process for playback when the build
# carries no address of its own. NARTYA_API_BASE overrides it. Leave empty to use the demo
# source recipe shipped with the repository.
VITE_API_BASE=

# Cloudflare Turnstile site key (public). Needed only if the Supabase project has bot and
# abuse protection turned on, which then refuses every auth call without a token. The
# packaged app serves its own captcha page on 127.0.0.1, so allow that host on the key.
VITE_TURNSTILE_SITE_KEY=
